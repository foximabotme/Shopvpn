# Required
BOT_TOKEN=
OWNER_ID=

# Railway / persistent storage
BOT_MODE=polling
DATA_DIR=/data
MINIAPP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
API_BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
TZ=Asia/Tehran
PYTHONUNBUFFERED=1

# Keep this stable and secret so web-admin sessions survive restarts.
ADMIN_PANEL_SECRET=

# Optional standalone web admin panel
ENABLE_ADMIN_PANEL=0
ADMIN_PANEL_PORT=8002
ADMIN_PANEL_URL=

# Optional payment integrations
PLISIO_API_KEY=
ABANGATEWAY_API_KEY=
BLUPAL_API_KEY=
NOAPAY_API_KEY=
NOAPAY_WEBHOOK_SECRET=

# Optional AI support providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_SUPPORT_MODEL=gemini-flash-latest

# Optional browser push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com

# Optional Firebase Cloud Messaging. Upload the JSON file to the volume first.
FIREBASE_SERVICE_ACCOUNT_PATH=/data/firebase-service-account.json
